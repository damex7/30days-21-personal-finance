# Copy to .env.local and fill in. Never commit .env.local.

# Neon: Project -> Connect -> "Connection pooling" ON (the host contains -pooler).
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# The site's public address, no trailing slash. Email links are built from
# it (never from the request's Host header).
APP_URL=http://localhost:3021

# Optional: without it, every email is printed in the terminal.
RESEND_API_KEY=
EMAIL_FROM=Àpò <onboarding@resend.dev>

# Protects /api/cron/recurring (Vercel Cron sends it as a Bearer token).
# A long random string:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
CRON_SECRET=

# Passwords for the accounts npm run db:seed creates (8-128 characters each):
#   seed.user@apo.example  (a year of sample data)
#   seed.admin@apo.example (an admin: sign-up counts and system health only)
SEED_USER_PASSWORD=
SEED_ADMIN_PASSWORD=
